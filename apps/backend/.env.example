DATABASE_URL=postgresql://postgres:postgres@localhost:5436/partnerup
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
DB_OPERATION_TIMEOUT_MS=250
# Fixed-port local fallback. The default repository-level development entry is
# `pnpm dev:portless`, where portless injects PORT for the managed app process.
PORT=4002
FIXED_IP_HTTP_PROXY=

# Frontend URL (share link base)
FRONTEND_URL=https://example.com
# Public backend API origin used by payment providers for unauthenticated callbacks.
PAYMENT_NOTIFY_BASE_URL=https://api.example.com
# Optional exact OAuth callback URL registered in WeChat. Defaults to the backend
# /api/wechat/oauth/callback URL inferred from the OAuth start request.
WECHAT_OAUTH_CALLBACK_URL=

# WeChat Official Account (JS-SDK signature)
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
WECHAT_AUTH_SESSION_SECRET=
WECHAT_SUBMSG_CONFIRMATION_REMINDER_TEMPLATE_ID=
WECHAT_SUBMSG_ACTIVITY_START_REMINDER_TEMPLATE_ID=
WECHAT_SUBMSG_BOOKING_RESULT_TEMPLATE_ID=
WECHAT_SUBMSG_NEW_PARTNER_TEMPLATE_ID=
WECHAT_SUBMSG_MEETING_POINT_UPDATED_TEMPLATE_ID=
WECHAT_SUBMSG_PR_MESSAGE_TEMPLATE_ID=

# WeCom (Enterprise WeChat) self-built app
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CORP_ID=
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=

# Purpose-scoped image storage directory (optional; defaults to /mnt/oss/images on Linux, ./images on Windows)
IMAGES_DIR=

# Mock
WECHAT_ABILITY_MOCKING_ENABLED=
WECHAT_ABILITY_MOCK_OPEN_ID=  # optional
