{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "dist/**",
    "tasks/**",
    "scratch/**",
    "images/**",
    "apps/backend/drizzle/**",
    "apps/backend/data-migrations/**",
    "apps/backend/seeds/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "vitest.config.ts",
        "vitest.backend.config.ts",
        "scripts/**/*.mjs",
        "scripts/**/*.ps1",
        "scripts/ci/**/*.sh"
      ],
      "project": [
        "*.ts",
        "*.json",
        "*.jsonc",
        "scripts/**/*.{js,mjs,ts,ps1,sh}",
        ".github/workflows/*.yml"
      ]
    },
    "apps/backend": {
      "entry": [
        "src/index.ts",
        "src/scripts/**/*.ts",
        "vitest.*.config.ts",
        "tsup*.config.ts",
        "drizzle.config.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
    },
    "apps/frontend": {
      "entry": [
        "src/main.ts",
        "src/app/create-app.ts",
        "src/**/*.test.ts",
        "scripts/*.mjs",
        "vite.config.ts",
        "vitest.config.ts",
        "uno.config.ts"
      ],
      "project": ["src/**/*.{ts,vue}", "scripts/*.mjs", "*.config.ts"]
    },
    "packages/fake-wechatpay-server": {
      "entry": ["src/index.ts", "bin/fake-wechatpay-server.ts", "vitest.config.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "vitest.config.ts"]
    },
    "packages/fake-caocao-server": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "tests/scenario": {
      "entry": ["vitest.config.ts", "**/*.scenario.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
