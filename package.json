{
  "name": "partner-up-dev",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.16.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @partner-up-dev/frontend dev & pnpm --filter @partner-up-dev/backend dev",
    "dev:ensure": "node ./scripts/ensure-dev-servers.mjs",
    "dev:portless": "node ./scripts/portless.mjs",
    "dev:portless:frontend": "node ./scripts/portless.mjs --name partner-up -- pnpm --filter @partner-up-dev/frontend dev",
    "dev:portless:backend": "node ./scripts/portless.mjs --name api.partner-up -- pnpm --filter @partner-up-dev/backend dev",
    "dev:portless:fake-caocao": "node ./scripts/portless.mjs --name caocao.partner-up -- pnpm --filter @partner-up-dev/fake-caocao-server dev",
    "dev:portless:fake-wechatpay": "node ./scripts/portless.mjs --name wechatpay.partner-up -- pnpm --filter @partner-up-dev/fake-wechatpay-server dev",
    "dev:frontend": "pnpm --filter @partner-up-dev/frontend dev",
    "dev:backend": "pnpm --filter @partner-up-dev/backend dev",
    "build:frontend": "pnpm --filter @partner-up-dev/frontend build",
    "build:backend": "pnpm --filter @partner-up-dev/backend build",
    "build": "pnpm check:build",
    "format": "biome format --write .",
    "format:check": "biome format --changed --no-errors-on-unmatched .",
    "format:check:all": "biome format .",
    "check:static": "pnpm check:format && pnpm check:lint && pnpm check:type && pnpm check:config && pnpm check:dead-code && pnpm check:security && pnpm check:build",
    "check:format": "pnpm format:check",
    "check:lint": "pnpm lint:biome && pnpm lint:structure && pnpm lint:policy",
    "check:lint:backend": "pnpm lint:biome:backend && pnpm lint:structure:backend && pnpm lint:backend",
    "check:lint:frontend": "pnpm lint:biome:frontend && pnpm --filter @partner-up-dev/frontend lint:tokens:strict && pnpm --filter @partner-up-dev/frontend audit:naming",
    "check:type": "pnpm check:type:backend && pnpm check:type:frontend && pnpm --filter @partner-up-dev/fake-wechatpay-server typecheck && pnpm --filter @partner-up-dev/fake-caocao-server typecheck",
    "check:type:backend": "pnpm --filter @partner-up-dev/backend typecheck",
    "check:type:frontend": "pnpm --filter @partner-up-dev/frontend exec vue-tsc --noEmit",
    "check:config": "pnpm check:config:backend && pnpm lint:payment-supply-chain",
    "check:config:backend": "pnpm db:lint && pnpm db:check",
    "check:dead-code": "pnpm lint:dead-code:report",
    "check:security": "pnpm lint:security:report",
    "check:build": "pnpm check:build:backend && pnpm check:build:frontend",
    "check:build:backend": "pnpm build:backend && pnpm --filter @partner-up-dev/backend build:db-migrate-fc",
    "check:build:frontend": "pnpm build:frontend",
    "lint": "pnpm check:lint",
    "lint:biome": "biome lint --changed --no-errors-on-unmatched .",
    "lint:biome:all": "biome lint .",
    "lint:biome:backend": "biome lint --changed --no-errors-on-unmatched apps/backend packages scripts",
    "lint:biome:frontend": "biome lint --changed --no-errors-on-unmatched apps/frontend",
    "lint:backend": "pnpm --filter @partner-up-dev/backend lint",
    "lint:structure": "pnpm lint:structure:backend",
    "lint:structure:backend": "ast-grep scan apps/backend/src --config sgconfig.yml --globs '*.ts' --globs '!**/*.test.ts' --globs '!apps/backend/src/index.ts' --globs '!apps/backend/src/scripts/lint/problem-details.ts'",
    "lint:policy": "pnpm lint:backend && pnpm --filter @partner-up-dev/frontend lint:tokens:strict && pnpm --filter @partner-up-dev/frontend audit:naming && pnpm lint:payment-supply-chain",
    "lint:dead-code": "knip",
    "lint:dead-code:report": "knip --no-exit-code --reporter compact --max-show-issues 50",
    "lint:payment-supply-chain": "node ./scripts/check-payment-supply-chain.mjs",
    "lint:security": "node ./scripts/run-semgrep.mjs --strict",
    "lint:security:report": "node ./scripts/run-semgrep.mjs --report",
    "test": "pnpm test:unit && pnpm test:scenario:all",
    "test:unit": "vitest run --project backend-unit --project frontend-unit",
    "test:unit:backend": "vitest run --config vitest.backend.config.ts --project backend-unit",
    "test:unit:frontend": "vitest run --project frontend-unit",
    "test:scenario:backend": "vitest run --config vitest.backend.config.ts --project backend-scenario",
    "test:scenario:system": "vitest run --project system-scenario",
    "test:scenario:all": "pnpm test:scenario:backend && pnpm test:scenario:system",
    "db:generate": "pnpm --filter @partner-up-dev/backend db:generate",
    "db:lint": "pnpm --filter @partner-up-dev/backend db:lint",
    "db:check": "pnpm --filter @partner-up-dev/backend exec drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "pnpm --filter @partner-up-dev/backend db:migrate",
    "db:migrate:dev": "pnpm --filter @partner-up-dev/backend db:migrate:dev",
    "db:reset": "pnpm --filter @partner-up-dev/backend db:reset",
    "db:reset:dev": "pnpm --filter @partner-up-dev/backend db:reset:dev",
    "db:seed": "pnpm --filter @partner-up-dev/backend db:seed",
    "db:next-migration": "pnpm --filter @partner-up-dev/backend db:next-migration",
    "db:studio": "pnpm --filter @partner-up-dev/backend db:studio"
  },
  "devDependencies": {
    "@partner-up-dev/fake-caocao-server": "workspace:*",
    "@ast-grep/cli": "0.43.0",
    "@biomejs/biome": "2.5.0",
    "@hono/node-server": "^1.19.9",
    "@partner-up-dev/fake-wechatpay-server": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "happy-dom": "^20.9.0",
    "knip": "6.17.1",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  }
}
